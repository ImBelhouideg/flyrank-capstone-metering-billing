# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/billing

# --- Server ---
PORT=3000

# --- Stripe (test mode only — keys below must start with pk_test_/sk_test_) ---
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_PRICE_ID=price_your_pro_plan_price_id_here

# --- Frontend/redirect URLs for Checkout (can stay localhost for the demo) ---
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
